              ".validate": "newData.isString() && ((auth != null && (auth.token.email == 'tanjicafe@gmail.com' || root.child('lephemere/todayStaff/_access/ownerUid').val() == auth.uid || root.child('lephemere/todayStaff/_access/users').child(auth.uid).child('role').val() == 'manager')) || newData.val() == auth.uid)"
            },
            "byStaffId": {
              ".validate": "newData.isString() && (newData.val() == '' || root.child('lephemere/staffRoster').child(newData.val()).exists())"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "audit": {
          "$id": {
            ".read": "auth != null && (auth.token.email == 'tanjicafe@gmail.com' || root.child('lephemere/todayStaff/_access/ownerUid').val() == auth.uid || root.child('lephemere/todayStaff/_access/users').child(auth.uid).child('role').val() == 'manager' || root.child('lephemere/todayStaff/_access/users').child(auth.uid).child('role').val() == 'orders') && (!data.exists() || data.child('uid').val() == auth.uid)",
            ".write": "auth != null && (auth.token.email == 'tanjicafe@gmail.com' || root.child('lephemere/todayStaff/_access/ownerUid').val() == auth.uid || root.child('lephemere/todayStaff/_access/users').child(auth.uid).child('role').val() == 'manager' || root.child('lephemere/todayStaff/_access/users').child(auth.uid).child('role').val() == 'orders') && !data.exists() && newData.exists() && newData.child('uid').val() == auth.uid && (newData.child('action').val() == 'macro' || newData.child('action').val() == 'participation')",
            ".validate": "newData.hasChildren(['action','target','reason','uid','staffId','createdAt']) && newData.child('createdAt').isNumber() && newData.child('reason').isString() && newData.child('reason').val().length <= 500"
          }
        }
      }
    }
  }
}
